      "svg": null,
      "archetype": "seq-arith",
      "parts": [
        {
          "q": "Bepaal 'n formule vir $T_n$, die $n$-de term van die ry.",
          "marks": 2,
          "solution": [
            "$a=5$, $d=4$",
            "$T_n=a+(n-1)d=5+4(n-1)=4n+1$"
          ],
          "answer": "$T_n=4n+1$"
        },
        {
          "q": "Watter term van die ry is gelyk aan $85$?",
          "marks": 2,
          "solution": [
            "$4n+1=85$",
            "$4n=84$, dus $n=21$"
          ],
          "answer": "Die $21$ste term"
        },
        {
          "q": "Bereken die som van die eerste $20$ terme van die ry.",
          "marks": 3,
          "solution": [
            "$S_n=\\dfrac{n}{2}\\left[2a+(n-1)d\\right]$",
            "$S_{20}=\\dfrac{20}{2}\\left[2(5)+19(4)\\right]=10(10+76)$",
            "$S_{20}=860$"
          ],
          "answer": "$S_{20}=860$"
        }
      ]
    },
