    {
     "q": "Bepaal die waarde(s) van $p$ waarvoor $2x^2+px+8=0$ gelyke wortels het.",
     "marks": 3,
     "solution": [
      "$\\Delta=p^2-4(2)(8)=0$",
      "$p^2=64$",
      "$p=8$ of $p=-8$"
     ],
     "answer": "$p=\\pm 8$"
    },
    {
     "q": "Toon aan dat die wortels van $x^2+(k+1)x+k=0$ reëel is vir ALLE reële waardes van $k$.",
     "marks": 4,
     "solution": [
      "$\\Delta=(k+1)^2-4(1)(k)$",
      "$=k^2+2k+1-4k$",
      "$=k^2-2k+1=(k-1)^2$",
      "$(k-1)^2\\geq 0$ vir alle $k$, dus is die wortels reëel vir alle reële $k$"
     ],
     "answer": "$\\Delta=(k-1)^2\\geq 0$ vir alle reële $k$, dus is die wortels altyd reëel"
    }
   ]
  },
